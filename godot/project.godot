; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="GovGen"
config/description="GovGen: a government-building and life simulation. This project is the graphical client; the game itself runs in the Python engine next to it (bridge/server.py)."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.05, 0.06, 0.08, 1)
boot_splash/show_image=false

[autoload]

Net="*res://scripts/core/net.gd"
G="*res://scripts/core/game_state.gd"
Shot="*res://scripts/dev/shot.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

timers/tooltip_delay_sec=0.35

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.03, 0.04, 0.06, 1)
